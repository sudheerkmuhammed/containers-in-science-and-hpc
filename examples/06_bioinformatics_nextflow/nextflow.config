// ==============================================================================
// Nextflow Configuration: Multi-Engine Portability (Docker vs Apptainer)
// Author: Sudheer K. Mohammed
// ==============================================================================

params {
    reads        = "$baseDir/data/*_R{1,2}.fastq.gz"
    outdir       = "results"
    trimmomatic_jar = "/usr/share/java/trimmomatic.jar"
}

profiles {
    // -------------------------------------------------------------------------
    // 1. LOCAL DOCKER PROFILE (Workstations, Mac, Windows WSL2)
    // -------------------------------------------------------------------------
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        process.executor       = 'local'
    }

    // -------------------------------------------------------------------------
    // 2. PRODUCTION HPC CLUSTER PROFILE (SLURM + Apptainer SIF)
    // -------------------------------------------------------------------------
    cluster {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        apptainer.cacheDir     = "/scratch/${USER}/apptainer_cache"

        process {
            executor           = 'slurm'
            queue              = 'bioinformatics'
            cpus               = 4
            memory             = '16 GB'
            time               = '2h'
            clusterOptions     = '--account=research_lab'
        }
    }
}
